@import url('https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0');

/* Canonical Tinter presentation. No patch or version layers should override this file. */
body.tinter-first{
  background:radial-gradient(circle at 50% -12%,#fffdf8 0,#f8f1e7 42%,#f1e8dc 100%);
}
body.tinter-first .shell{
  width:min(1040px,calc(100% - 28px));
  padding:28px 0 80px;
}
.tinter-home{
  position:relative;
  min-height:min(680px,82vh);
  display:grid;
  place-items:center;
  padding:clamp(38px,7vw,80px);
  overflow:hidden;
  border:1px solid rgba(114,91,73,.10);
  border-radius:34px;
  background:rgba(255,253,248,.92);
  box-shadow:0 24px 70px rgba(58,38,29,.08);
  text-align:center;
}
.tinter-home::before{
  content:"";
  position:absolute;
  width:430px;
  height:430px;
  top:-250px;
  right:-190px;
  border-radius:50%;
  background:radial-gradient(circle,rgba(181,109,75,.12),transparent 68%);
  pointer-events:none;
}
.tinter-home-copy{position:relative;z-index:1;width:min(760px,100%);margin:auto}
.tinter-home-brand{display:flex;justify-content:center;margin-bottom:20px}
.tinter-home h1{
  max-width:760px;
  margin:0 auto 18px;
  font-size:clamp(44px,7vw,72px);
  line-height:.96;
  letter-spacing:-.06em;
}
.tinter-home .lead{
  max-width:650px;
  margin:0 auto;
  font-size:clamp(16px,2vw,20px);
  line-height:1.5;
  color:#554a42;
}
.tinter-look-for{
  max-width:680px;
  margin:25px auto 0;
}
.tinter-look-for>b{
  display:block;
  font-family:var(--cute,"Quicksand",sans-serif);
  font-size:11px;
  font-weight:800;
  letter-spacing:.13em;
  text-transform:uppercase;
  color:var(--terra,#b56d4b);
}
.tinter-look-for-list{
  display:flex;
  flex-wrap:wrap;
  justify-content:center;
  gap:5px 18px;
  margin-top:7px;
  color:#6a5d54;
  font-size:12px;
  font-weight:650;
}
.tinter-look-for-list span+span::before{content:"·";margin-right:18px;color:#b8a99c}
.tinter-home-actions{
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:9px;
  margin-top:34px;
}
.tinter-launch{display:grid;justify-items:center;gap:8px}
.tinter-start-prompt{
  margin:0;
  font-family:var(--cute,"Quicksand",sans-serif);
  font-size:10px;
  font-weight:850;
  letter-spacing:.16em;
  text-transform:uppercase;
  color:#88776a;
}
.tinter-entry{
