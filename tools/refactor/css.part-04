  border:1px solid rgba(255,255,255,.14);
  border-radius:999px;
  background:rgba(10,10,11,.28);
  color:white;
  font-family:var(--cute,"Quicksand",sans-serif);
  font-size:9px;
  font-weight:800;
  box-shadow:none;
  backdrop-filter:blur(10px);
  -webkit-backdrop-filter:blur(10px);
}
.tinter-light-badge[data-quality=good],.tinter-light-badge[data-quality=skipped]{opacity:0;pointer-events:none}
.tinter-light-badge[data-quality=checking]{width:9px;min-width:9px;height:9px;min-height:9px;padding:0;border:0;font-size:0;background:rgba(255,255,255,.58)}
.tinter-light-badge[data-quality=low]{background:rgba(119,55,43,.80)}

.smooth-drape-preview{
  position:absolute;
  z-index:5;
  left:0;
  right:0;
  bottom:0;
  height:100%;
  opacity:0;
  transform:translate3d(0,0,0) scaleY(0);
  transform-origin:bottom center;
  pointer-events:none;
  transition:opacity .14s ease,transform .14s ease;
}
.smooth-deck{
  position:absolute;
  z-index:12;
  left:12px;
  right:12px;
  bottom:calc(env(safe-area-inset-bottom) + 64px);
  height:190px;
  pointer-events:none;
}
.smooth-card{
  position:absolute;
  bottom:0;
  width:calc(50% - 6px);
  max-width:304px;
  min-height:170px;
  padding:10px;
  touch-action:none;
  pointer-events:auto;
  border:1px solid #e5ddd0;
  border-radius:16px;
  background:#f8f5ef;
  color:#4d443c;
  box-shadow:0 14px 36px rgba(0,0,0,.24),inset 0 1px 0 rgba(255,255,255,.78);
  transform:translate3d(0,0,0);
  transition:transform .24s cubic-bezier(.2,.9,.25,1.12),opacity .18s ease,box-shadow .18s ease;
  cursor:pointer;
}
.smooth-card[data-side=left]{left:max(0px,calc(50% - 316px))}
.smooth-card[data-side=right]{right:max(0px,calc(50% - 316px))}
.smooth-card.is-muted{opacity:.30;transform:scale(.96)}
.smooth-card.is-dragging{z-index:15;transition:none;box-shadow:0 22px 48px rgba(0,0,0,.30)}
.smooth-card.is-returning{transition:transform .28s cubic-bezier(.18,.9,.22,1),opacity .18s ease,box-shadow .18s ease}
.smooth-card.is-throwing{transition:transform .24s cubic-bezier(.18,.85,.2,1),opacity .2s ease;opacity:.92}
.smooth-card.is-commit-ready{outline:2px solid rgba(239,219,198,.88);outline-offset:3px}
.smooth-card:focus-visible{outline:3px solid rgba(255,253,248,.9);outline-offset:4px}
.smooth-card *{pointer-events:none}
.smooth-chip{
  height:120px;
  margin-bottom:9px;
  border:7px solid #fbf8f2;
  border-radius:10px;
  box-shadow:0 0 0 1px rgba(0,0,0,.06),inset 0 0 0 1px rgba(255,255,255,.12);
}
.smooth-name{
  display:block;
  font-family:var(--cute,"Quicksand",sans-serif);
  font-size:10.5px;
  font-weight:800;
  line-height:1;
  letter-spacing:.11em;
  text-transform:uppercase;
  text-align:center;
}
.tinter-choice-footer{
  position:absolute;
  z-index:16;
  left:0;
  right:0;
  bottom:calc(env(safe-area-inset-bottom) + 10px);
  display:grid;
  place-items:center;
  pointer-events:none;
}
.tinter-no-diff{
