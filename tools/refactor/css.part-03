.tinter-settings-icon i{position:absolute;left:1px;right:1px;height:2px;border-radius:999px;background:currentColor}
.tinter-settings-icon i:nth-child(1){top:3px}.tinter-settings-icon i:nth-child(2){top:8px}.tinter-settings-icon i:nth-child(3){top:13px}
.tinter-settings-icon i::after{content:"";position:absolute;top:50%;width:6px;height:6px;transform:translate(-50%,-50%);border:2px solid currentColor;border-radius:50%;background:#202123;box-sizing:border-box}
.tinter-settings-icon i:nth-child(1)::after{left:5px}.tinter-settings-icon i:nth-child(2)::after{left:12px}.tinter-settings-icon i:nth-child(3)::after{left:8px}
.tinter-settings-toggle.is-active{background:rgba(247,239,230,.94);color:#493a31;border-color:transparent}
.tinter-settings-toggle.is-active .tinter-settings-icon i::after{background:#f7efe6}

.tinter-progress{
  position:absolute;
  z-index:42;
  left:0;
  right:0;
  top:0;
  height:2px;
  overflow:hidden;
  background:rgba(255,255,255,.08);
}
.tinter-progress i{display:block;width:0;height:100%;background:rgba(240,217,197,.92);transition:width .2s ease}
.tinter-question{
  position:absolute;
  z-index:35;
  top:calc(env(safe-area-inset-top) + 70px);
  left:50%;
  width:min(560px,calc(100% - 28px));
  padding:12px 48px 13px 15px;
  transform:translateX(-50%);
  border:1px solid rgba(255,255,255,.28);
  border-radius:17px;
  background:rgba(250,246,239,.94);
  color:#493a31;
  box-shadow:0 10px 28px rgba(0,0,0,.15);
  backdrop-filter:blur(18px) saturate(115%);
  -webkit-backdrop-filter:blur(18px) saturate(115%);
}
.tinter-question-label{
  display:block;
  font-family:var(--cute,"Quicksand",sans-serif);
  font-size:8.5px;
  font-weight:800;
  letter-spacing:.13em;
  text-transform:uppercase;
  color:#9a6d55;
}
.tinter-question-main{
  display:block;
  margin-top:3px;
  font-family:var(--serif,Georgia,serif);
  font-size:clamp(17px,3.2vw,21px);
  font-weight:500;
  line-height:1.12;
  letter-spacing:-.025em;
}
.tinter-step-count{
  display:block;
  margin-top:4px;
  font-size:9.5px;
  font-weight:750;
  color:#8a7d72;
}
.tinter-judge-inline{
  display:block;
  margin-top:4px;
  font-size:10.5px;
  line-height:1.38;
  color:#6f645c;
}
.tinter-question-help{
  position:absolute;
  top:9px;
  right:9px;
  width:30px;
  min-width:30px;
  height:30px;
  min-height:30px;
  display:grid;
  place-items:center;
  padding:0;
  border:1px solid rgba(93,72,55,.18);
  border-radius:50%;
  background:transparent;
  color:#493a31;
  font:italic 700 16px/1 Georgia,serif;
  cursor:pointer;
}
.tinter-question-help[aria-expanded=true]{background:#493a31;color:white;border-color:#493a31}
.tinter-light-badge{
  position:absolute;
  z-index:42;
  top:calc(env(safe-area-inset-top) + 61px);
  right:68px;
  min-height:28px;
  padding:4px 9px;
