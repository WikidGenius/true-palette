  z-index:120;
  height:var(--tinter-height,100dvh);
  background:#0d0e0f;
  overflow:hidden;
  overscroll-behavior:contain;
}
.tinter-modal[hidden]{display:none}
.tinter-card{
  position:relative;
  width:100%;
  height:100%;
  overflow:hidden;
  background:#101112;
  color:white;
  isolation:isolate;
}
.tinter-stage{
  position:absolute;
  inset:0;
  overflow:hidden;
  background:#111;
  touch-action:none;
  -webkit-user-select:none;
  user-select:none;
}
.tinter-stage video{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
  transform:scaleX(-1) translateZ(0);
}
.tinter-stage::after{
  content:"";
  position:absolute;
  inset:0;
  z-index:3;
  background:radial-gradient(circle at 50% 34%,transparent 0 25%,rgba(0,0,0,.04) 55%,rgba(0,0,0,.20) 100%);
  pointer-events:none;
  transition:background .18s ease;
}
.tinter-video-filter{position:absolute;inset:0;z-index:1;pointer-events:none;mix-blend-mode:color;background:transparent}
.tinter-face-guide{
  position:absolute;
  z-index:4;
  left:50%;
  top:43%;
  width:min(45vw,310px);
  height:min(58vh,450px);
  transform:translate(-50%,-50%);
  border:1px solid rgba(255,255,255,.13);
  border-radius:48% 48% 45% 45%;
  opacity:.45;
  pointer-events:none;
}
.tinter-head{
  position:absolute;
  z-index:40;
  top:calc(env(safe-area-inset-top) + 10px);
  left:12px;
  right:12px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  pointer-events:none;
}
.tinter-interface-brand{pointer-events:none}
.tinter-interface-brand .tinter-word{font-size:29px;color:rgba(255,255,255,.94)}
.tinter-interface-brand .tinter-style-glyph{width:23px;height:23px;font-size:23px;color:#e7c9ae}
.tinter-head-actions{display:flex;gap:8px;pointer-events:auto}
.tinter-icon-button{
  width:44px;
  min-width:44px;
  height:44px;
  min-height:44px;
  display:grid;
  place-items:center;
  padding:0;
  border:1px solid rgba(255,255,255,.12);
  border-radius:50%;
  background:rgba(10,10,11,.24);
  color:rgba(255,255,255,.92);
  box-shadow:none;
  backdrop-filter:blur(12px);
  -webkit-backdrop-filter:blur(12px);
  cursor:pointer;
}
.tinter-icon-button:hover,.tinter-icon-button:focus-visible{background:rgba(10,10,11,.40);outline:none}
.tinter-close{font:300 28px/1 var(--sans,Arial,sans-serif)}
.tinter-settings-icon{position:relative;display:inline-block;width:18px;height:18px}
