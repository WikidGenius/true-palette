  min-height:38px;
  padding:6px 13px;
  border:0;
  border-radius:999px;
  background:rgba(9,9,10,.24);
  color:rgba(255,255,255,.82);
  font-family:var(--cute,"Quicksand",sans-serif);
  font-size:11px;
  font-weight:750;
  box-shadow:none;
  backdrop-filter:blur(8px);
  -webkit-backdrop-filter:blur(8px);
  pointer-events:auto;
  cursor:pointer;
}
.tinter-no-diff:hover,.tinter-no-diff:focus-visible{background:rgba(9,9,10,.40);color:white;outline:none}
.tinter-no-diff:disabled{opacity:.45;cursor:wait}
.tinter-return-zone{
  position:absolute;
  z-index:9;
  left:6px;
  right:6px;
  bottom:5px;
  height:28%;
  display:flex;
  align-items:flex-start;
  justify-content:center;
  padding-top:12px;
  border:1px dashed rgba(255,255,255,.24);
  border-radius:22px;
  background:linear-gradient(180deg,rgba(12,12,13,.03),rgba(12,12,13,.38));
  color:rgba(255,255,255,.86);
  font-family:var(--cute,"Quicksand",sans-serif);
  font-size:10.5px;
  font-weight:800;
  opacity:0;
  transform:translateY(14px);
  transition:opacity .16s ease,transform .16s ease,height .16s ease,background .16s ease;
  pointer-events:none;
}
.tinter-return-zone span{padding:7px 11px;border-radius:999px;background:rgba(8,8,9,.42);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.tinter-stage.card-drag-active .tinter-return-zone{opacity:1;transform:none}
.tinter-stage.card-commit-ready .tinter-return-zone{height:20%;background:linear-gradient(180deg,rgba(12,12,13,.02),rgba(93,72,55,.28))}
.tinter-stage.smooth-done .smooth-deck{display:none}

.tinter-balance{
  position:absolute;
  z-index:50;
  top:calc(env(safe-area-inset-top) + 62px);
  right:12px;
  width:min(340px,calc(100% - 24px));
  padding:14px;
  border:1px solid rgba(255,255,255,.50);
  border-radius:18px;
  background:rgba(250,246,239,.98);
  color:#493a31;
  box-shadow:0 20px 56px rgba(0,0,0,.30);
  backdrop-filter:blur(22px);
  -webkit-backdrop-filter:blur(22px);
}
.tinter-balance[hidden]{display:none}
.tinter-balance-top{display:flex;align-items:center;justify-content:space-between;gap:10px}
.tinter-balance-top b{font-family:var(--cute,"Quicksand",sans-serif);font-size:13px}
.tinter-balance-top button{padding:7px 10px;border:1px solid rgba(93,72,55,.15);border-radius:999px;background:white;color:#493a31;font-size:11px}
.tinter-balance-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}
.tinter-balance label{display:grid;gap:5px;font-size:10px;font-weight:750;color:#6f645c}
.tinter-balance input{width:100%;accent-color:var(--teal,#2f5d62)}
.tinter-balance-note{margin:7px 0 0;font-size:10.5px;line-height:1.35;color:#6f645c}
.tinter-card.settings-open .tinter-question,.tinter-card.settings-open .smooth-deck,.tinter-card.settings-open .tinter-choice-footer{opacity:.20;pointer-events:none}

.tinter-status{
  position:absolute;
  z-index:34;
  top:calc(env(safe-area-inset-top) + 190px);
  left:50%;
  max-width:min(520px,calc(100% - 42px));
  min-height:14px;
  margin:0;
  transform:translateX(-50%);
  color:rgba(255,255,255,.88);
  font-size:10px;
  line-height:1.3;
  text-align:center;
  text-shadow:0 1px 8px rgba(0,0,0,.42);
  pointer-events:none;
}
.tinter-question-help-panel{
  position:absolute;
  z-index:60;
  left:50%;
  width:min(520px,calc(100% - 24px));
  max-height:min(250px,calc(100% - 300px));
